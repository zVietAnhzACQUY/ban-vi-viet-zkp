# ============================================================
# BẢN VỊ VIỆT - CẤU HÌNH MẪU
# ============================================================
# Sao chép tệp này thành apps/.env rồi thay các placeholder.
#
# Không commit apps/.env, mật khẩu, khóa mã hóa, private key,
# credential, token hoặc đường dẫn hồ sơ thật lên Git.
#
# Nếu mật khẩu PostgreSQL chứa ký tự đặc biệt, phải percent-encode
# phần mật khẩu trước khi đưa vào connection URL.
# ============================================================


# ============================================================
# DATABASE
# ============================================================

# Database nghiệp vụ chính.
DATABASE_URL=postgresql://bvv:CHANGE_ME_URL_ENCODED@127.0.0.1:5434/banviviet?schema=public

# Schema riêng dành cho kiểm thử tự động.
# Không dùng schema public và không dùng lại schema test cũ.
TEST_DATABASE_URL=postgresql://bvv:CHANGE_ME_URL_ENCODED@127.0.0.1:5434/banviviet?schema=g2_test_local


# ============================================================
# BACKEND / API
# ============================================================

NODE_ENV=development
API_PORT=3001
API_ORIGIN=http://127.0.0.1:3001

# Origin Website được API tin cậy.
APP_ORIGIN=http://127.0.0.1:5173
WEB_ORIGIN=http://127.0.0.1:5173
WEBSITE_ORIGIN=http://127.0.0.1:5173

# Origin của các thành phần được phép tương tác với API.
WALLET_ORIGIN=http://127.0.0.1:5174
ISSUER_PORTAL_ORIGIN=http://127.0.0.1:5175


# ============================================================
# FRONTEND - VITE
# ============================================================

WEB_PORT=5173
WALLET_PORT=5174
ISSUER_PORTAL_PORT=5175

VITE_WEB_ORIGIN=http://127.0.0.1:5173
VITE_WEB_ORIGINS=http://127.0.0.1:5173
VITE_WALLET_ORIGIN=http://127.0.0.1:5174
VITE_ISSUER_PORTAL_ORIGIN=http://127.0.0.1:5175
VITE_API_ORIGIN=http://127.0.0.1:3001
VITE_ISSUER_DELIVERY_ORIGIN=http://127.0.0.1:3002


# ============================================================
# AGE CREDENTIAL DELIVERY
# ============================================================

ISSUER_DELIVERY_PORT=3002
ISSUER_DELIVERY_ORIGIN=http://127.0.0.1:3002

# Khóa riêng cho Delivery:
# - 32 byte ngẫu nhiên;
# - mã hóa base64;
# - không dùng private signing key;
# - không dùng lại khóa Evidence;
# - không commit giá trị thật vào Git.
AGE_DELIVERY_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_KEY


# ============================================================
# AGE / LOT EVIDENCE STORAGE
# ============================================================

# Thư mục lưu hồ sơ mã hóa phải:
# - nằm ngoài repository;
# - nằm ngoài web root;
# - chỉ tài khoản vận hành được truy cập;
# - sử dụng persistent storage khi triển khai.
#
# Ví dụ local:
# D:/BanViVietPrivate/evidence
AGE_EVIDENCE_STORAGE_DIR=CHANGE_ME_OUTSIDE_REPOSITORY

# Khóa mã hóa hồ sơ AGE/LOT:
# - 32 byte ngẫu nhiên;
# - mã hóa base64;
# - khác khóa Delivery;
# - không commit giá trị thật.
AGE_EVIDENCE_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_KEY