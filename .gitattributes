# Chuẩn hóa source thông thường về LF.
* text=auto eol=lf

# Định dạng nhị phân.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.docx binary
*.pdf binary
*.zip binary
*.gz binary
*.dump binary
*.wasm binary
*.zkey binary
*.ptau binary

# Bảo toàn nguyên byte vì liên quan checksum hoặc bằng chứng.
artifacts/** -text
prisma/migrations/** -text
docs/evidence/** -text