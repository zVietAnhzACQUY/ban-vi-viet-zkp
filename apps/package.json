{
  "name": "ban-vi-viet-commerce",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "api",
    "wallet",
    "issuer-portal"
  ],
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,DELIVERY,WEB,WALLET,ISSUER_PORTAL \"npm run dev -w api\" \"tsx watch issuer/delivery-server.ts\" \"npm run dev -w web\" \"npm run dev -w wallet\" \"npm run dev -w issuer-portal\"",
    "build": "npm run build -w web && npm run build -w wallet && npm run build -w issuer-portal && tsc --noEmit",
    "db:generate": "node scripts/generate.mjs",
    "db:migrate": "prisma migrate deploy --schema ../prisma/schema.prisma",
    "db:seed": "tsx api/src/seed.ts",
    "issuer:age": "tsx issuer/issue-age.ts",
    "issuer:delivery": "tsx issuer/delivery-server.ts",
    "issuer:operator": "tsx issuer/provision-operator-cli.ts",
    "issuer:lot": "tsx issuer/issue-lot.ts",
    "prover:lot": "tsx prover/prove-lot.ts",
    "verify:lot": "tsx prover/verify-lot-bundle.ts",
    "test": "tsx api/tests/run.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/rate-limit": "10.3.0",
    "@prisma/client": "6.12.0",
    "argon2": "0.44.0",
    "circomlibjs": "0.1.7",
    "dotenv": "17.2.3",
    "fastify": "5.12.5",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.18.4",
    "snarkjs": "0.7.6",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.9.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "9.2.4",
    "prettier": "3.6.2",
    "prisma": "6.12.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
